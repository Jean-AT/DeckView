# Backend server
PORT=3000
NODE_ENV=development

# PostgreSQL (Prisma connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/devops_dashboard

# Redis
REDIS_URL=redis://localhost:6379

# Auth (JWT) — generate with: openssl rand -hex 32
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Master key used to encrypt provider API keys (AES-256-GCM).
# Generate with: openssl rand -base64 32
CREDENTIALS_MASTER_KEY=generate-with-openssl-rand-base64-32

# Cron schedule for the provider sync job (Vercel/GitHub/Jenkins polling)
SYNC_CRON_SCHEDULE=*/5 * * * *
