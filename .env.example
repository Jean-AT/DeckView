# Backend server
PORT=3000
NODE_ENV=development

# PostgreSQL (Prisma connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/devops_dashboard

# Redis
REDIS_URL=redis://localhost:6379

# Auth (JWT) — local-dev defaults. For anything beyond your PC: openssl rand -hex 32
JWT_SECRET=deckview-local-jwt-secret-change-me
JWT_REFRESH_SECRET=deckview-local-jwt-refresh-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Master key used to encrypt provider API keys (AES-256-GCM).
# Local-dev 32-byte key. For anything beyond your PC: openssl rand -base64 32
CREDENTIALS_MASTER_KEY=bG9jYWwtZGV2LW9ubHktZG8tbm90LXVzZS1wcm9kISE=

# Cron schedule for the provider sync job (Vercel/GitHub/Jenkins polling)
SYNC_CRON_SCHEDULE=*/5 * * * *

# Outbound rate limiting towards external provider APIs (calls per minute)
OUTBOUND_RATE_LIMIT_PER_MINUTE=30

# Shared secret authenticating inbound webhooks (header x-webhook-secret).
WEBHOOK_SECRET=deckview-local-webhook-secret-change-me

# Allowed CORS origins, comma-separated
CORS_ORIGINS=http://localhost:5173
